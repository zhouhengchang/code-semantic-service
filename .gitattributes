# 默认保持仓库内统一用 LF，避免 Windows 上提交的文件在 Linux 容器里出问题
* text=auto eol=lf

# 这两类文件必须是 LF：CRLF 会让容器里的 sh 脚本报 bad interpreter，
# Dockerfile 也会因为行尾符导致指令解析异常
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
docker-entrypoint.sh text eol=lf

# 批处理反而必须 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，不要做行尾转换
*.png binary
*.jpg binary
*.zip binary
*.pdf binary
