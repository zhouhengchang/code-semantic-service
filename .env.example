# ============================================================
# 环境变量模板 —— 复制为 .env 后填写
# 注意：.env 已在 .gitignore 中，绝不要提交到仓库
# ============================================================

# ---------- 核心服务 ----------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-coder
OLLAMA_TIMEOUT=300
SERVICE_NAME=monetizable-code-service

# 核心服务地址（适配层调用它）
CORE_BASE_URL=http://127.0.0.1:8000

# ---------- B. x402 / Circle ----------
# 你的 USDC 收款钱包地址（EVM，0x 开头）。留空则付费层不启用。
X402_SELLER_ADDRESS=
# Circle Gateway 网络
X402_NETWORK=base
# 付费墙金额（USD 计价字符串）
X402_PRICE_REFACTOR=$0.01
X402_PRICE_SEMANTIC=$0.005
# 付费服务监听端口
X402_PORT=8402

# ---------- C. Claw Mart ----------
CLAWMART_API_KEY=
CLAWMART_API_BASE=https://www.shopclawmart.com/api/v1

# ---------- D. 豆包 / 扣子 ----------
# 公网部署后的地址，例如 https://xxx.fly.dev
PUBLIC_BASE_URL=
COZE_BOT_ID=
COZE_API_TOKEN=

# ---------- F. GitHub / x402-deploy ----------
GITHUB_REPO=
# 部署平台凭证（按你选用的平台填其一）
RAILWAY_TOKEN=
FLY_API_TOKEN=
VERCEL_TOKEN=
